{
  "redirects": [
    {
      "source": "/RobloxDevStore-v1.0.0.apk",
      "destination": "https://github.com/nawfalsalimi2004-ctrl/store-roblox-app/releases/download/v1.0.0/RobloxDevStore-v1.0.0.apk",
      "permanent": false
    },
    {
      "source": "/RobloxDevStore-Flutter-v1.0.0.apk",
      "destination": "https://github.com/nawfalsalimi2004-ctrl/store-roblox-app/releases/download/v1.0.0/RobloxDevStore-Flutter-v1.0.0.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300" }
      ]
    },
    {
      "source": "/RobloxDevStore-v1.0.0.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"RobloxDevStore-v1.0.0.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/games",
      "destination": "/api/games.json"
    },
    {
      "source": "/api/articles",
      "destination": "/api/articles.json"
    },
    {
      "source": "/api/feed",
      "destination": "/api/feed.json"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
